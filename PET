-- ===== DRAG FUNCTIONALITY =====
local dragging = false
local dragStartPos
local dragStartMousePos

local function updateDrag(input)
    local delta = input.Position - dragStartMousePos
    mainFrame.Position = UDim2.new(0, dragStartPos.X.Offset + delta.X, 0, dragStartPos.Y.Offset + delta.Y)
end

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStartPos = mainFrame.Position
        dragStartMousePos = input.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

titleBar.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateDrag(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateDrag(input)
    end
end)

-- ===== ANIMATION LOGIC =====
local enabled = true
local currentIndex = 0
local targetName = textBox.Text
local speed = 0.1
local animationTask = nil
local currentDisplayName = ""

local function setPetName(name)
    local args = { name }
    PetRenameRequest:FireServer(unpack(args))
end

local function updateStatus()
    if not enabled then
        statusLabel.Text = "⏸ Disabled"
        return
    end
    
    local displayText = targetName
    if #displayText > 15 then
        displayText = displayText:sub(1, 12) .. "..."
    end
    statusLabel.Text = "⚡ Animating: " .. displayText .. " (" .. currentIndex .. "/" .. #targetName .. ")"
end

local function animateLetterByLetter()
    while enabled do
        -- Reset index when we complete the name
        if currentIndex > #targetName then
            -- Wait a moment at full name
            setPetName(targetName)
            task.wait(0.5)
            
            -- Clear and reset
            setPetName("")
            currentIndex = 0
            task.wait(0.1)
        end
        
        -- Build name up to current index
        if currentIndex <= #targetName then
            currentDisplayName = targetName:sub(1, currentIndex)
            setPetName(currentDisplayName)
            updateStatus()
            
            -- Move to next letter
            currentIndex = currentIndex + 1
            
            -- Wait before adding next letter
            task.wait(speed)
        end
    end
end

local function startAnimation()
    if animationTask then
        task.cancel(animationTask)
        animationTask = nil
    end
    
    if not enabled then return end
    
    -- Reset animation state
    currentIndex = 0
    currentDisplayName = ""
    
    -- Start new animation coroutine
    animationTask = task.spawn(function()
        animateLetterByLetter()
    end)
end

local function stopAnimation()
    enabled = false
    if animationTask then
        task.cancel(animationTask)
        animationTask = nil
    end
    setPetName("")
    updateStatus()
end

local function restartAnimation()
    if animationTask then
        task.cancel(animationTask)
        animationTask = nil
    end
    
    if enabled then
        -- Reset state
        currentIndex = 0
        currentDisplayName = ""
        updateStatus()
        
        -- Start fresh animation
        animationTask = task.spawn(function()
            animateLetterByLetter()
        end)
    end
end

-- TextBox change detection
textBox:GetPropertyChangedSignal("Text"):Connect(function()
    local newText = textBox.Text
    
    -- Update target name
    if newText == "" then
        targetName = " "
    else
        targetName = newText
    end
    
    -- Restart animation with new text
    if enabled then
        restartAnimation()
    end
    
    updateStatus()
end)

-- Toggle button
toggleBtn.MouseButton1Click:Connect(function()
    if enabled then
        -- Disable animation
        enabled = false
        stopAnimation()
        toggleBtn.Text = "⏸ DISABLED"
        toggleBtn.TextColor3 = Color3.fromRGB(255, 150, 150)
        toggleBtn.BackgroundColor3 = Color3.fromRGB(100, 70, 70)
        setPetName("")
    else
        -- Enable animation
        enabled = true
        toggleBtn.Text = "▶ ANIMATING"
        toggleBtn.TextColor3 = Color3.fromRGB(150, 255, 150)
        toggleBtn.BackgroundColor3 = Color3.fromRGB(70, 100, 70)
        startAnimation()
    end
    updateStatus()
end)

-- Close button
closeBtn.MouseButton1Click:Connect(function()
    if animationTask then
        task.cancel(animationTask)
    end
    setPetName("")
    screenGui:Destroy()
end)

-- Speed slider functionality
local sliderDragging = false

local function updateSpeedFromSlider(input)
    local relativeX = math.clamp((input.Position.X - speedSlider.AbsolutePosition.X) / speedSlider.AbsoluteSize.X, 0, 1)
    speed = 0.05 + (relativeX * 0.1)
    speed = math.clamp(speed, 0.05, 0.15)
    
    -- Update visual
    local percent = (speed - 0.05) / 0.1
    sliderFill.Size = UDim2.new(percent, 0, 1, 0)
    sliderKnob.Position = UDim2.new(percent, -8, 0.5, -8)
    speedLabel.Text = "⚡ Speed: " .. string.format("%.2f", speed) .. "s"
    
    -- Restart animation with new speed
    if enabled then
        restartAnimation()
    end
end

sliderKnob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = true
        updateSpeedFromSlider(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSpeedFromSlider(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = false
    end
end)

-- Also allow clicking on the track
speedSlider.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        updateSpeedFromSlider(input)
    end
end)

-- Initialize
updateSpeedFromSlider({Position = speedSlider.AbsolutePosition + Vector2.new(speedSlider.AbsoluteSize.X * 0.5, 0)})
startAnimation()
